//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  SPY DipScore v1 — tiered pullback-in-uptrend system, daily bars
//  Mirrors the validated Python backtest exactly.
//  Validated on SPY daily 2000-01-03 .. 2026-03-20.
//    TRAIN 2000-2015 : 150 trades, 71.3% win, R:R 1:0.60, PF 1.49
//    TEST  2016-2026 : 117 trades, 76.1% win, R:R 1:0.58, PF 1.83, t=2.92
//    Random-entry control at the same stop/target geometry wins ~65%.
//    The edge is the ~+0.13R per trade ABOVE that control, not the win rate.
//  This is a LOW-FREQUENCY system: ~10 setups per year. It is not a daily setup.
// ═══════════════════════════════════════════════════════════════════════════
strategy("SPY DipScore v1", shorttitle="DIPSCORE", overlay=true,
         initial_capital=100000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.01, slippage=1, calc_on_every_tick=false,
         process_orders_on_close=false, max_labels_count=500)

// ══════════════ INPUTS — Core Settings ══════════════
gC = "Core Settings"
atrLen    = input.int(14,  "ATR length",              group=gC, minval=2)
trendLen  = input.int(200, "Trend SMA length",        group=gC, minval=20)
slopeLb   = input.int(20,  "Trend slope lookback",    group=gC, minval=1)
midLen    = input.int(50,  "Mid SMA length",          group=gC, minval=5)

// ══════════════ INPUTS — Signal Tuning ══════════════
gS = "Signal Tuning"
rsiLen    = input.int(2,   "RSI length",              group=gS, minval=1)
rsiLoose  = input.float(10,"RSI level (loose)",       group=gS)
rsiTight  = input.float(5, "RSI level (tight)",       group=gS)
ibsLevel  = input.float(0.20, "IBS level",            group=gS, step=0.05)
lowLb     = input.int(10,  "N-day low lookback",      group=gS, minval=2)
streakMin = input.int(3,   "Down-close streak",       group=gS, minval=1)
volLb     = input.int(504, "Vol percentile lookback", group=gS, minval=60)
volLen    = input.int(20,  "Realised vol length",     group=gS, minval=5)
thrA      = input.float(0.55, "Tier A threshold",     group=gS, step=0.05)
thrB      = input.float(0.35, "Tier B threshold — the traded line", group=gS, step=0.05)
thrC      = input.float(0.20, "Tier C threshold",     group=gS, step=0.05)
tradeTier = input.string("B and better", "Trade which tiers",
            options=["A only","B and better","C and better"], group=gS)

// ══════════════ INPUTS — Risk Management ══════════════
gR = "Risk Management"
stopATR   = input.float(2.0, "Stop (x ATR)",          group=gR, step=0.25)
targATR   = input.float(1.0, "Target (x ATR)",        group=gR, step=0.25)
maxHold   = input.int(5,   "Max bars in trade",       group=gR, minval=1)
riskPct   = input.float(1.0, "Risk per trade (% equity)", group=gR, step=0.25)
useRisk   = input.bool(true, "Size by risk instead of full equity", group=gR)

// ══════════════ INPUTS — Visuals / Filter mode ══════════════
gV = "Visual Settings"
showTint  = input.bool(true, "Regime background tint", group=gV)
showTable = input.bool(true, "Info table",             group=gV)
filterMode= input.bool(false,"Filter mode (hidden state output only)", group=gV)

// ══════════════ CALCULATIONS ══════════════
atr      = ta.atr(atrLen)
sma200   = ta.sma(close, trendLen)
sma50    = ta.sma(close, midLen)
upTrend  = close > sma200 and (sma200 - sma200[slopeLb]) > 0

rsi2     = ta.rsi(close, rsiLen)
ibs      = (high - low) == 0 ? 0.5 : (close - low) / (high - low)
prevLow  = ta.lowest(low, lowLb)[1]

var int dnStreak = 0
dnStreak := close < close[1] ? nz(dnStreak[1]) + 1 : 0

ret      = close / close[1] - 1
rv       = ta.stdev(ret, volLen) * math.sqrt(252)
volPct   = ta.percentrank(rv, volLb) / 100.0

// trend / range / volatile regime (display + research only, not a gate:
// the regime filter was tested and did NOT improve out-of-sample results)
effRatio = math.abs(close - close[20]) / math.sum(math.abs(close - close[1]), 20)
regime   = volPct > 0.80 ? 2 : effRatio > 0.35 ? 1 : 0   // 2=volatile 1=trend 0=range

// ── confluence score ──
score  = 0.0
score += rsi2 < rsiLoose            ? 0.25 : 0.0
score += rsi2 < rsiTight            ? 0.10 : 0.0
score += ibs < ibsLevel             ? 0.20 : 0.0
score += close <= prevLow           ? 0.20 : 0.0
score += dnStreak >= streakMin      ? 0.15 : 0.0
score += close < sma50              ? 0.10 : 0.0
score += volPct < 0.80              ? 0.10 : 0.0
score += volPct > 0.90              ? -0.15 : 0.0
score := upTrend ? score : 0.0

tierA = score >= thrA
tierB = score >= thrB and not tierA
tierC = score >= thrC and not tierA and not tierB

entryThr = tradeTier == "A only" ? thrA : tradeTier == "B and better" ? thrB : thrC
longSig  = score >= entryThr and upTrend

// ══════════════ EXECUTION ══════════════
// Order is submitted on the close of the signal bar and fills at the NEXT open,
// which is exactly how the Python backtest measured it.
var float entryPx  = na
var float stopPx   = na
var float targPx   = na
var int   barsHeld  = 0

qty = useRisk ? (strategy.equity * riskPct / 100.0) / math.max(stopATR * atr, syminfo.mintick)
              : strategy.equity / close

if longSig and strategy.position_size == 0 and not filterMode
    stopPx := close - stopATR * atr      // levels fixed off the SIGNAL bar's ATR
    targPx := close + targATR * atr
    strategy.entry("Long", strategy.long, qty=useRisk ? qty : na)

if strategy.position_size > 0
    barsHeld += 1
    // re-anchor the bracket to the actual fill price on the first held bar
    if barsHeld == 1
        entryPx := strategy.position_avg_price
        stopPx  := entryPx - stopATR * atr[1]
        targPx  := entryPx + targATR * atr[1]
    strategy.exit("X", "Long", stop=stopPx, limit=targPx)
    if barsHeld >= maxHold
        strategy.close("Long", comment="time")
else
    barsHeld := 0

// ══════════════ VISUALS ══════════════
plot(filterMode ? na : sma200, "SMA200", color.new(color.gray, 0), 2)
plot(filterMode ? na : sma50,  "SMA50",  color.new(color.gray, 60), 1)

plotshape(filterMode ? false : tierA, "Tier A", shape.triangleup, location.belowbar,
          color.new(color.lime, 0), size=size.small)
plotshape(filterMode ? false : tierB, "Tier B", shape.diamond, location.belowbar,
          color.new(color.green, 20), size=size.tiny)
plotshape(filterMode ? false : tierC, "Tier C", shape.circle, location.belowbar,
          color.new(color.teal, 45), size=size.tiny)

bgcolor(showTint and not filterMode ?
        (regime == 1 ? color.new(color.green, 93) :
         regime == 2 ? color.new(color.red, 93) : color.new(color.orange, 95)) : na)

if showTable and not filterMode and barstate.islast
    var table t = table.new(position.top_right, 2, 5, border_width=1)
    table.cell(t, 0, 0, "DipScore",   text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(t, 1, 0, str.tostring(score, "#.00"), text_color=color.white,
               bgcolor=color.new(color.blue, 30))
    table.cell(t, 0, 1, "Trend");   table.cell(t, 1, 1, upTrend ? "UP" : "no")
    table.cell(t, 0, 2, "Regime");  table.cell(t, 1, 2, regime == 1 ? "trend" : regime == 2 ? "volatile" : "range")
    table.cell(t, 0, 3, "RSI2");    table.cell(t, 1, 3, str.tostring(rsi2, "#.0"))
    table.cell(t, 0, 4, "IBS");     table.cell(t, 1, 4, str.tostring(ibs, "#.00"))

// ══════════════ FILTER MODE — hidden state for external scripts ══════════════
plot(longSig ? 1 : 0, "Filter State",      display=display.none)
plot(score,           "Filter Confidence", display=display.none)
plot(regime,          "Filter Regime",     display=display.none)

// ══════════════ ALERTS ══════════════
alertcondition(tierA, "DipScore Tier A", "SPY DipScore Tier A setup — buy next open")
alertcondition(tierB, "DipScore Tier B", "SPY DipScore Tier B setup — buy next open")
alertcondition(tierC, "DipScore Tier C", "SPY DipScore Tier C setup — marginal")
